{% extends 'base.html.twig' %}


{% block steelsheets %}{% endblock %}

{% block body %}

	<h1 class="titre-form">Ajouter une technologie</h1>


	{{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}} )}}

	<div class="label-titre">
		{{ form_label( form.titre, null, {label_attr:{'classs':'form-label'}}
		) }}
		{{ form_widget( form.titre, {attr:{'class':'form-input'}}
		) }}
	</div>
	<div class="label-desc">
		{{ form_label( form.niveau, null, {label_attr:{'classs':'form-label'}}
		) }}
		{{ form_widget( form.niveau, {attr:{'class':'form-input'}}
		) }}
	</div>


	<div class="label-upload">
		{{ form_row(form.icone, {'attr': {'class':'form-upload', 'enctype': 'multipart/form-data'}}) }}
	</div>

<button type="submit" class="btn-form">Ajouter</button>

	{{ form_end(form) }}

{% endblock %}
