{% extends 'base.html.twig' %}


{% block stylesheets %}{% endblock %}
{% block body %}
	<h1 class="titre-form">Ajouter une experience</h1>

	{{ form_start(form) }}

	<div class="label-titre">
		{{ form_label(form.titre, null, {label_attr:{'class':'form-label'}}) }}
		{{ form_widget(form.titre, {attr:{'class':'form-input'}})}}

	</div>

	<div class="label-desc">
		{{ form_label(form.entreprise, null, {label_attr:{'class':'form-label'}}) }}
		{{ form_widget(form.entreprise, {attr:{'class':'form-input'}})}}

	</div>
	<div class="label-desc">
		{{ form_label(form.description, null, {label_attr:{'class':'form-label'}}) }}
		{{ form_widget(form.description, {attr:{'class':'form-input'}})}}

	</div>

	<div class="label-tags">
		{{ form_row(form.createdAt, {label_attr:{'class':'form-label'}}) }}
	</div>
	<div class="label-tags">
		{{ form_row(form.endedAt, {label_attr:{'class':'form-label'}}) }}
		

	</div>

	<br>

	<button type="submit" class="btn-form">Ajouter</button>

	{{ form_end(form) }}
{% endblock %}
