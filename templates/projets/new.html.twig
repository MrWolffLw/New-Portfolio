{% extends 'base.html.twig' %}


{% block stylesheets %}{% endblock %}
{% block body %}
	<h1 class="titre-form">Ajouter un projet</h1>

	{{ form_start(form) }}

	<div class="label-titre">
		{{ form_label(form.titre, null, {label_attr:{'class':'form-label'}}) }}
		{{ form_widget(form.titre, {attr:{'class':'form-input'}})}}

	</div>

	<div class="label-desc">
		{{ form_label(form.description, null, {label_attr:{'class':'form-label'}}) }}
		{{ form_widget(form.description, {attr:{'class':'form-input'}})}}

	</div>

	<div class="label-tags">
		{{ form_label(form.tags, null, {label_attr:{'class':'form-label'}}) }}
		{{ form_widget(form.tags, {attr:{'class':'form-input'}})}}

	</div>

	<div class="label-tags">
		{{ form_start(form.image, {'attr': {'enctype': 'multipart/form-data'}}) }}

	</div>
	<br>

	<button type="submit" class="btn-form">Ajouter</button>

	{{ form_end(form) }}
{% endblock %}
